// SPDX-License-Identifier: Apache-2.0
// peregrine desktop shell — ADR 0001 (Slint), design direction A
// "terminal heritage": continuous with the TUI's visual language
// (near-black, teal accent, amber mentions). All colors and type flow
// through the Theme global — no literals in components.

import { ListView, LineEdit, Button } from "std-widgets.slint";

global Theme {
    // color tokens
    out property <color> base:     #14161a;
    out property <color> surface:  #1b1e23;
    out property <color> surface-2: #23272f;
    out property <color> ink:      #d7dce3;
    out property <color> ink-dim:  #8b949e;
    out property <color> accent:   #1b8cf0;
    out property <color> mention:  #e3b341;
    out property <color> ok:       #7ee787;
    out property <color> danger:   #ff7b72;
    // type scale
    out property <length> text-body:  14px;
    out property <length> text-meta:  12px;
    out property <length> text-header: 15px;
}

export struct RoomItem {
    name: string,
    unread: int,
}

export struct TimelineItem {
    sender: string,
    body: string,
    mention: bool,
}

component RoomRow inherits Rectangle {
    in property <string> name;
    in property <int> unread;
    in property <bool> selected;
    callback clicked();

    height: name-text.preferred-height + 18px;
    background: selected ? Theme.surface-2 : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        name-text := Text {
            vertical-alignment: center;
            horizontal-stretch: 1;
            text: root.name;
            color: selected ? Theme.ok : Theme.ink;
            overflow: elide;
        }
        if root.unread > 0: Rectangle {
            width: unread-text.preferred-width + 14px;
            height: unread-text.preferred-height + 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: #2d3a2f;
            unread-text := Text {
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.unread;
                font-size: Theme.text-meta;
                color: Theme.ok;
            }
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component MessageRow inherits Rectangle {
    in property <string> sender;
    in property <string> body;
    in property <bool> mention;

    height: body-text.preferred-height + sender-text.preferred-height + 16px;
    background: root.mention ? #241f14 : transparent;

    HorizontalLayout {
        padding-left: 4px;
        Rectangle { width: 2px; background: root.mention ? Theme.mention : transparent; }
        VerticalLayout {
            padding-left: 8px;
            padding-right: 10px;
            padding-top: 5px;
            spacing: 1px;
            sender-text := Text {
                text: root.sender;
                font-size: Theme.text-meta;
                color: Theme.accent;
            }
            body-text := Text {
                text: root.body;
                wrap: word-wrap;
                overflow: elide;
                color: root.mention ? Theme.mention : Theme.ink;
            }
        }
    }
}

export component SpikeWindow inherits Window {
    title: "peregrine";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.base;

    in property <[RoomItem]> rooms;
    in property <[TimelineItem]> timeline;
    in property <string> status-line: "connecting";
    in-out property <int> selected-room;
    in-out property <length> timeline-scroll-y;
    out property <int> sent-count;
    // Content height minus viewport height — the bench's scroll range.
    out property <length> scroll-range: Math.max(0px, lv.content-height - lv.height);

    callback room-selected(int);
    callback send(string);

    VerticalLayout {
        // Header bar: identity + connection state.
        Rectangle {
            height: 44px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                Text {
                    vertical-alignment: center;
                    text: "peregrine";
                    font-size: Theme.text-header;
                    font-weight: 700;
                    color: Theme.ink;
                }
                Rectangle { horizontal-stretch: 1; }
                status-dot := Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: root.status-line == "connected" ? Theme.ok : Theme.danger;
                }
                status-text := Text {
                    vertical-alignment: center;
                    text: root.status-line;
                    font-size: Theme.text-meta;
                    color: Theme.ink-dim;
                }
            }
        }

        // Body: rooms | timeline+composer.
        HorizontalLayout {
            // Pane 1: room list.
            Rectangle {
                width: 250px;
                background: Theme.surface;
                room-list := ListView {
                    for r[i] in rooms: RoomRow {
                        name: r.name;
                        unread: r.unread;
                        selected: i == selected-room;
                        clicked => {
                            selected-room = i;
                            root.room-selected(i);
                        }
                    }
                }
            }

            // Panes 2+3: timeline over composer.
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                lv := ListView {
                    viewport-y <=> timeline-scroll-y;
                    for msg in timeline: MessageRow {
                        sender: msg.sender;
                        body: msg.body;
                        mention: msg.mention;
                    }
                }
                HorizontalLayout {
                    height: 42px;
                    spacing: 8px;
                    input := LineEdit {
                        placeholder-text: "message…";
                        accepted(text) => { root.send(text); input.text = ""; }
                    }
                    Button {
                        width: 90px;
                        text: "Send";
                        clicked => {
                            root.send(input.text);
                            input.text = "";
                        }
                    }
                }
            }
        }
    }
}
