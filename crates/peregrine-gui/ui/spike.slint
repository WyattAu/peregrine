// SPDX-License-Identifier: Apache-2.0
// ADR 0001 spike: three-pane layout (rooms / timeline / composer) with a
// 10k-event timeline model. Mock data only — the gate criteria are
// layout capability, scripted-scroll FPS, and cold start, not protocol.

import { ListView, LineEdit, Button } from "std-widgets.slint";

export struct RoomItem {
    name: string,
    unread: int,
}

export struct TimelineItem {
    sender: string,
    body: string,
    mention: bool,
}

export component SpikeWindow inherits Window {
    title: "peregrine";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #1b1e23;

    in property <[RoomItem]> rooms;
    in property <[TimelineItem]> timeline;
    in-out property <int> selected-room;
    in-out property <length> timeline-scroll-y;
    out property <int> sent-count;
    // Content height minus viewport height — the bench's scroll range.
    out property <length> scroll-range: Math.max(0px, lv.content-height - lv.height);

    callback room-selected(int);
    callback send(string);

    HorizontalLayout {
        // Pane 1: room list.
        Rectangle {
            width: 240px;
            background: #23272f;
            room-list := ListView {
                for r[i] in rooms: Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            vertical-alignment: center;
                            text: r.name;
                            color: i == selected-room ? #7ee787 : #d7dce3;
                        }
                        Rectangle {
                            width: 30px;
                            Text {
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                text: r.unread > 0 ? r.unread : "";
                                color: #ff7b72;
                            }
                        }
                    }
                    TouchArea {
                        clicked => {
                            selected-room = i;
                            root.room-selected(i);
                        }
                    }
                    Rectangle {
                        y: self.height - self.height;
                        height: 1px;
                        background: #2e3440;
                    }
                }
            }
        }

        // Panes 2+3: timeline over composer.
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            lv := ListView {
                content-y <=> timeline-scroll-y;
                for msg in timeline: Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text {
                            width: 160px;
                            vertical-alignment: center;
                            text: msg.sender;
                            color: #79c0ff;
                            overflow: elide;
                        }
                        Text {
                            vertical-alignment: center;
                            text: msg.body;
                            color: msg.mention ? #e3b341 : #d7dce3;
                            overflow: elide;
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 40px;
                spacing: 8px;
                input := LineEdit {
                    placeholder-text: "message…";
                }
                Button {
                    width: 90px;
                    text: "Send";
                    clicked => {
                        root.send(input.text);
                        input.text = "";
                    }
                }
            }
        }
    }
}
